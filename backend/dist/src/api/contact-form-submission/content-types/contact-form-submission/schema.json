{
    "kind": "collectionType",
    "collectionName": "contact_form_submissions",
    "info": {
        "singularName": "contact-form-submission",
        "pluralName": "contact-form-submissions",
        "displayName": "contact_form_submissions"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "full_name": {
            "type": "string",
            "required": true
        },
        "phone_number": {
            "type": "string",
            "required": true
        },
        "email": {
            "type": "email"
        },
        "subject": {
            "type": "string"
        },
        "message": {
            "type": "blocks",
            "required": true
        },
        "voice_message": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "files",
                "audios"
            ]
        }
    }
}
