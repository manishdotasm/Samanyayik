    },
    "time": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "consultationType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "offline",
        "online"
      ]
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "string"
    },
    "coordinates": {
      "type": "json"
    },
    "issue": {
      "type": "blocks"
    },
    "voiceMessage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "audios"
      ]
    }
  }
